# Application Settings
APP_NAME="FitWardrobe AI (VYRO)"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vfroom"

# Storage Settings
STORAGE_BACKEND="local" # "local" or "supabase" or "cloudinary"
STORAGE_LOCAL_ROOT="../../storage"

# AI Inference Settings
ENABLE_GPU=False
DEVICE="cpu" # "cuda" or "cpu"
VTON_MODEL_PATH="yisol/IDM-VTON" # or "CatVTON"
